{
  "name": "dsh-cache-tools",
  "version": "0.1.0",
  "description": "Prompt-cache stats, cache-hit graphs, and footer execution timers for DeepSeek Harness — a port of pi-cache-optimizer, pi-cache-graph, and pi-execution-time",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "BEHAVIOR.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "cordis",
    "prompt-cache",
    "cache-hit",
    "tokens"
  ],
  "author": "Xiangzhe",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xz-dev/dsh-cache-tools.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2"
  }
}
